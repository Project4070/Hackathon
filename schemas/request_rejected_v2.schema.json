{
  "$defs": {
    "ContractIssueV2": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "field_path": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^/.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field Path"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "field_path",
        "message",
        "evidence_ids"
      ],
      "title": "ContractIssueV2",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "warning",
        "blocking",
        "fatal"
      ],
      "title": "IssueSeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "const": "planning_intake",
      "default": "planning_intake",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "vocabulary_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Vocabulary Version",
      "type": "string"
    },
    "status": {
      "const": "request_rejected",
      "default": "request_rejected",
      "title": "Status",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "case_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Case Id",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$",
      "title": "Reason Code",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ContractIssueV2"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "case_id",
    "reason_code",
    "issues"
  ],
  "title": "RequestRejectedV2",
  "type": "object"
}
