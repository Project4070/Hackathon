      "type": "object"
    },
    "PlanningIntakeV2": {
      "additionalProperties": false,
      "properties": {
        "schema_name": {
          "const": "planning_intake",
          "default": "planning_intake",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "vocabulary_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Vocabulary Version",
          "type": "string"
        },
        "status": {
          "const": "ready_for_planning",
          "default": "ready_for_planning",
          "title": "Status",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "profile_revision": {
          "minimum": 1,
          "title": "Profile Revision",
          "type": "integer"
        },
        "validated_at": {
          "format": "date-time",
          "title": "Validated At",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/ValidatedMealProfileV2"
        },
        "validation_receipt": {
          "$ref": "#/$defs/ValidationReceiptV2"
        }
      },
      "required": [
        "request_id",
        "case_id",
        "profile_revision",
        "validated_at",
        "profile",
        "validation_receipt"
      ],
      "title": "PlanningIntakeV2",
      "type": "object"
    },
    "PreferencePolarity": {
      "enum": [
        "prefer",
        "avoid"
      ],
      "title": "PreferencePolarity",
      "type": "string"
    },
    "PreferenceStrength": {
      "enum": [
        "weak",
        "normal",
        "strong"
      ],
