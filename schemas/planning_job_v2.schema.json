          "type": "string"
        }
      },
      "required": [
        "requested_at",
        "resolved_location",
        "restaurant_snapshot_id",
        "trace_id"
      ],
      "title": "PlannerExecutionContextV2",
      "type": "object"
    },
    "PlannerRuntimePolicyV2": {
      "additionalProperties": false,
      "properties": {
        "serving_policy": {
          "$ref": "#/$defs/ServingPolicyRefV2"
        },
        "budget_policy": {
          "$ref": "#/$defs/BudgetPolicyV2"
        },
        "restaurant_search": {
          "$ref": "#/$defs/RestaurantSearchPolicyV2"
        },
        "menu_filter": {
          "$ref": "#/$defs/MenuFilterPolicyV2"
        },
        "combination": {
          "$ref": "#/$defs/CombinationPolicyV2"
        },
        "ranking": {
          "$ref": "#/$defs/RankingPolicyV2"
        }
      },
      "required": [
