{
  "$defs": {
    "ActivityContext": {
      "enum": [
        "ordinary",
        "club_meal",
        "meeting",
        "workshop",
        "party",
        "sports_event",
        "school_event",
        "other"
      ],
      "title": "ActivityContext",
      "type": "string"
    },
    "ActivityLevel": {
      "enum": [
        "none",
        "light",
        "moderate",
        "heavy",
        "unknown"
      ],
      "title": "ActivityLevel",
      "type": "string"
    },
    "AppetiteBand": {
      "enum": [
        "very_light",
        "light",
        "normal",
        "large",
        "very_large",
        "custom"
      ],
      "title": "AppetiteBand",
      "type": "string"
    },
    "AppetiteProfileV2": {
      "additionalProperties": false,
      "properties": {
        "band": {
          "$ref": "#/$defs/AppetiteBand"
        },
        "stated_servings_milli": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stated Servings Milli"
        }
      },
      "required": [
        "band",
        "stated_servings_milli"
      ],
      "title": "AppetiteProfileV2",
      "type": "object"
    },
    "AssumptionV2": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "field_path": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^/.*",
          "title": "Field Path",
          "type": "string"
        },
        "applied_value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Applied Value",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "field_path",
        "applied_value",
        "reason",
        "evidence_ids"
      ],
      "title": "AssumptionV2",
      "type": "object"
    },
    "AttendanceStatus": {
      "enum": [
        "confirmed",
        "expected",
        "uncertain",
        "late"
      ],
      "title": "AttendanceStatus",
      "type": "string"
    },
    "BudgetMaximumSource": {
      "enum": [
        "none",
        "explicit",
        "policy_tolerance",
        "policy_default"
      ],
      "title": "BudgetMaximumSource",
      "type": "string"
    },
    "BudgetPolicyV2": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Policy Id",
          "type": "string"
        },
        "approximate_tolerance_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Approximate Tolerance Basis Points",
          "type": "integer"
        }
      },
      "required": [
        "policy_id",
        "approximate_tolerance_basis_points"
      ],
      "title": "BudgetPolicyV2",
      "type": "object"
    },
    "CategorySelection": {
      "enum": [
        "include_all",
        "any_of",
        "prefer_all"
      ],
      "title": "CategorySelection",
      "type": "string"
    },
    "CombinationPolicyV2": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Policy Id",
          "type": "string"
        },
        "allow_duplicate_menu_items": {
          "title": "Allow Duplicate Menu Items",
          "type": "boolean"
        },
        "maximum_distinct_items": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum Distinct Items"
        },
        "maximum_total_quantity": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum Total Quantity"
        }
      },
      "required": [
        "policy_id",
        "allow_duplicate_menu_items",
        "maximum_distinct_items",
        "maximum_total_quantity"
      ],
      "title": "CombinationPolicyV2",
      "type": "object"
    },
    "ContractIssueV2": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "field_path": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^/.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field Path"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "field_path",
        "message",
        "evidence_ids"
      ],
      "title": "ContractIssueV2",
      "type": "object"
    },
    "CostScopeV2": {
      "additionalProperties": false,
      "properties": {
        "include_menu_price": {
          "title": "Include Menu Price",
          "type": "boolean"
        },
        "include_delivery_fee": {
          "title": "Include Delivery Fee",
          "type": "boolean"
        },
        "include_service_fee": {
          "title": "Include Service Fee",
          "type": "boolean"
        },
        "include_discount": {
          "title": "Include Discount",
          "type": "boolean"
        }
      },
      "required": [
        "include_menu_price",
        "include_delivery_fee",
        "include_service_fee",
        "include_discount"
      ],
      "title": "CostScopeV2",
      "type": "object"
    },
    "DiversityPolicyV2": {
      "additionalProperties": false,
      "properties": {
        "category_balance": {
          "title": "Category Balance",
          "type": "boolean"
        },
        "avoid_single_item_dominance": {
          "title": "Avoid Single Item Dominance",
          "type": "boolean"
        },
        "duplicate_penalty_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Duplicate Penalty Basis Points",
          "type": "integer"
        }
      },
      "required": [
        "category_balance",
        "avoid_single_item_dominance",
        "duplicate_penalty_basis_points"
      ],
      "title": "DiversityPolicyV2",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "explicit",
        "inferred",
        "defaulted",
        "conflicted"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceV2": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "field_path": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^/.*",
          "title": "Field Path",
          "type": "string"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Text"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "start_offset": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Offset"
        },
        "end_offset": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Offset"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        }
      },
      "required": [
        "evidence_id",
        "field_path",
        "source_text",
        "status",
        "confidence",
        "start_offset",
        "end_offset",
        "note"
      ],
      "title": "EvidenceV2",
      "type": "object"
    },
    "FoodRole": {
      "enum": [
        "primary_meal",
        "supplementary_meal",
        "snack",
        "tasting",
        "other"
      ],
      "title": "FoodRole",
      "type": "string"
    },
    "FoodScopeV2": {
      "additionalProperties": false,
      "properties": {
        "requested_categories": {
          "items": {
            "$ref": "#/$defs/SemanticTermV2"
          },
          "maxItems": 16,
          "title": "Requested Categories",
          "type": "array"
        },
        "category_selection": {
          "$ref": "#/$defs/CategorySelection"
        },
        "excluded_categories": {
          "items": {
            "$ref": "#/$defs/SemanticTermV2"
          },
          "maxItems": 16,
          "title": "Excluded Categories",
          "type": "array"
        },
        "restaurant_mixing": {
          "$ref": "#/$defs/RestaurantMixing"
        }
      },
      "required": [
        "requested_categories",
        "category_selection",
        "excluded_categories",
        "restaurant_mixing"
      ],
      "title": "FoodScopeV2",
      "type": "object"
    },
    "HardConstraintUnknownPolicy": {
      "enum": [
        "exclude"
      ],
      "title": "HardConstraintUnknownPolicy",
      "type": "string"
    },
    "HardRequirementKind": {
      "enum": [
        "allergy",
        "diet",
        "food_exclusion",
        "religious_rule",
        "spice_limit"
      ],
      "title": "HardRequirementKind",
      "type": "string"
    },
    "HardRequirementV2": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/HardRequirementKind"
        },
        "affected_group_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Affected Group Ids",
          "type": "array"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/SemanticTermV2"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Terms",
          "type": "array"
        },
        "source_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "kind",
        "affected_group_ids",
        "terms",
        "source_text"
      ],
      "title": "HardRequirementV2",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "warning",
        "blocking",
        "fatal"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "LeftoverStorage": {
      "enum": [
        "available",
        "unavailable",
        "unknown"
      ],
      "title": "LeftoverStorage",
      "type": "string"
    },
    "LocaleCode": {
      "enum": [
        "ko",
        "en",
        "mixed",
        "unknown"
      ],
      "title": "LocaleCode",
      "type": "string"
    },
    "LocationRequirementV2": {
      "additionalProperties": false,
      "properties": {
        "delivery_required": {
          "title": "Delivery Required",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/LocationSource"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Query"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Longitude"
        }
      },
      "required": [
        "delivery_required",
        "source",
        "query",
        "latitude",
        "longitude"
      ],
      "title": "LocationRequirementV2",
      "type": "object"
    },
    "LocationSource": {
      "enum": [
        "user_text",
        "browser_geolocation",
        "request_context",
        "application_default"
      ],
      "title": "LocationSource",
      "type": "string"
    },
    "MealType": {
      "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "late_night",
        "snack",
        "other"
      ],
      "title": "MealType",
      "type": "string"
    },
    "MenuEvaluationMode": {
      "enum": [
        "individual_menu"
      ],
      "title": "MenuEvaluationMode",
      "type": "string"
    },
    "MenuFilterPolicyV2": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Policy Id",
          "type": "string"
        },
        "evaluation_mode": {
          "$ref": "#/$defs/MenuEvaluationMode"
        },
        "unknown_ingredient_policy": {
          "$ref": "#/$defs/UnknownIngredientPolicy"
        },
        "hard_constraint_unknown_policy": {
          "$ref": "#/$defs/HardConstraintUnknownPolicy"
        },
        "eligibility_output_schema": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Eligibility Output Schema",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "evaluation_mode",
        "unknown_ingredient_policy",
        "hard_constraint_unknown_policy",
        "eligibility_output_schema"
      ],
      "title": "MenuFilterPolicyV2",
      "type": "object"
    },
    "OccasionCandidateV2": {
      "additionalProperties": false,
      "properties": {
        "meal_type": {
          "$ref": "#/$defs/MealType"
        },
        "service_style": {
          "$ref": "#/$defs/ServiceStyle"
        },
        "activity_context": {
          "$ref": "#/$defs/ActivityContext"
        },
        "food_role": {
          "$ref": "#/$defs/FoodRole"
        },
        "leftover_storage": {
          "$ref": "#/$defs/LeftoverStorage"
        },
        "scheduled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scheduled At"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10080,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Minutes"
        }
      },
      "required": [
        "meal_type",
        "service_style",
        "activity_context",
        "food_role",
        "leftover_storage",
        "scheduled_at",
        "duration_minutes"
      ],
      "title": "OccasionCandidateV2",
      "type": "object"
    },
    "ParticipantGroupV2": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Group Id",
          "type": "string"
        },
        "display_label": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Label"
        },
        "count": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "Count",
          "type": "integer"
        },
        "attendance_status": {
          "$ref": "#/$defs/AttendanceStatus"
        },
        "appetite": {
          "$ref": "#/$defs/AppetiteProfileV2"
        },
        "activity_level": {
          "$ref": "#/$defs/ActivityLevel"
        },
        "recent_meal_status": {
          "$ref": "#/$defs/RecentMealStatus"
        }
      },
      "required": [
        "group_id",
        "display_label",
        "count",
        "attendance_status",
        "appetite",
        "activity_level",
        "recent_meal_status"
      ],
      "title": "ParticipantGroupV2",
      "type": "object"
    },
    "PartyCandidateV2": {
      "additionalProperties": false,
      "properties": {
        "total_count": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "Total Count",
          "type": "integer"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/ParticipantGroupV2"
          },
          "maxItems": 100,
          "title": "Groups",
          "type": "array"
        }
      },
      "required": [
        "total_count",
        "groups"
      ],
      "title": "PartyCandidateV2",
      "type": "object"
    },
    "PlannerExecutionContextV2": {
      "additionalProperties": false,
      "properties": {
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "resolved_location": {
          "$ref": "#/$defs/ResolvedLocationV2"
        },
