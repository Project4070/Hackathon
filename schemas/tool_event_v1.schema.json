  "required": [
    "event_id",
    "event_type",
    "call_id",
    "trace_id",
    "case_id",
    "profile_revision",
    "stage",
    "tool_name",
    "occurred_at",
    "input_artifact_ids",
    "output_artifact_ids",
    "summary"
