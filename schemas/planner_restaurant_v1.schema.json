        "practical_servings_max_milli": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Practical Servings Max Milli",
          "type": "integer"
        },
        "selected_servings_milli": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Selected Servings Milli",
          "type": "integer"
        },
        "confidence": {
