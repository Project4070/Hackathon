      "required": [
        "evidence_id",
        "source_url",
        "source_text",
        "practical_servings_min_milli",
        "practical_servings_max_milli",
        "selected_servings_milli",
        "confidence",
        "observation_count",
        "reviewed"
      ],
      "title": "ServingEvidenceV1",
      "type": "object"
    },
    "SpiceLevel": {
      "enum": [
        "none",
        "mild",
        "medium",
        "hot",
        "unknown"
      ],
      "title": "SpiceLevel",
      "type": "string"
    },
    "VegetarianStatus": {
      "enum": [
        "explicit_yes",
        "explicit_no",
        "inferred",
        "unknown"
      ],
      "title": "VegetarianStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The only Naver-derived object allowed to cross into the planner.",
