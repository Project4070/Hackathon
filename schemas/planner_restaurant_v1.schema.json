{
  "$defs": {
    "AvailabilityStatus": {
      "enum": [
        "available",
        "unavailable",
        "unknown"
      ],
      "title": "AvailabilityStatus",
      "type": "string"
    },
    "ConfidenceLabel": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ConfidenceLabel",
      "type": "string"
    },
    "DeliveryCapabilityV1": {
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        },
        "provider": {
          "const": "naver-order",
          "default": "naver-order",
          "title": "Provider",
          "type": "string"
        },
        "pickup_available": {
          "title": "Pickup Available",
          "type": "boolean"
        },
        "target_address_status": {
          "enum": [
            "verified",
            "unknown",
            "not_requested"
          ],
          "title": "Target Address Status",
          "type": "string"
        }
      },
      "required": [
        "confirmed",
        "pickup_available",
        "target_address_status"
      ],
      "title": "DeliveryCapabilityV1",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "error",
        "warning"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "PlannerDataIssueV1": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "field_path": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "corrective_action": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Corrective Action",
          "type": "string"
        }
      },
      "required": [
        "code",
        "field_path",
        "severity",
        "reason",
        "corrective_action"
      ],
      "title": "PlannerDataIssueV1",
      "type": "object"
    },
    "PlannerLocationJoinV1": {
      "additionalProperties": false,
      "description": "The candidate edge between one requested location and one place.",
      "properties": {
        "location_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Location Id",
          "type": "string"
        },
        "candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "request_latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Request Latitude",
          "type": "number"
        },
        "request_longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Request Longitude",
          "type": "number"
        },
        "place_latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Place Latitude",
          "type": "number"
        },
        "place_longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Place Longitude",
          "type": "number"
        },
        "distance_meters": {
          "minimum": 0,
          "title": "Distance Meters",
          "type": "integer"
        },
        "radius_meters": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Radius Meters",
          "type": "integer"
        },
        "within_radius": {
          "title": "Within Radius",
          "type": "boolean"
        }
      },
      "required": [
        "location_id",
        "candidate_id",
        "request_latitude",
        "request_longitude",
        "place_latitude",
        "place_longitude",
        "distance_meters",
        "radius_meters",
        "within_radius"
      ],
      "title": "PlannerLocationJoinV1",
      "type": "object"
    },
    "PlannerMenuItemV1": {
      "additionalProperties": false,
      "properties": {
        "menu_item_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
