          "type": "string"
        },
        "source_menu_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source Menu Id",
          "type": "string"
        },
        "restaurant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Restaurant Id",
          "type": "string"
        },
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "original_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "price_minor": {
          "anyOf": [
            {
              "maximum": 10000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Minor"
        },
        "price_text": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Text"
        },
        "sale_unit": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sale Unit"
        },
        "category_code": {
          "default": "unknown",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Category Code",
          "type": "string"
        },
        "piece_count": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Piece Count"
        },
        "pizza_diameter_cm_milli": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pizza Diameter Cm Milli"
        },
        "slice_count": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slice Count"
        },
        "vegetarian_status": {
          "$ref": "#/$defs/VegetarianStatus",
          "default": "unknown"
        },
        "verified_free_allergens": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Verified Free Allergens",
          "type": "array"
        },
        "allergen_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Allergen Tags",
          "type": "array"
        },
        "spice_level": {
          "$ref": "#/$defs/SpiceLevel",
          "default": "unknown"
        },
        "availability": {
          "$ref": "#/$defs/AvailabilityStatus",
          "default": "unknown"
        },
        "serving_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServingEvidenceV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "semantic_provenance": {
          "$ref": "#/$defs/SemanticProvenanceV1"
        },
        "inferred_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Inferred Tags",
          "type": "array"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlannerDataIssueV1"
          },
          "maxItems": 32,
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "menu_item_id",
        "source_menu_id",
        "restaurant_id",
        "name",
        "original_text",
        "semantic_provenance"
      ],
      "title": "PlannerMenuItemV1",
      "type": "object"
    },
    "PlannerSourceProvenanceV1": {
      "additionalProperties": false,
      "properties": {
        "source_system": {
          "const": "naver_place",
          "default": "naver_place",
          "title": "Source System",
          "type": "string"
        },
        "source_restaurant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source Restaurant Id",
          "type": "string"
        },
        "source_url": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "parser_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Parser Version",
          "type": "string"
        },
        "data_mode": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Data Mode",
          "type": "string"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source_restaurant_id",
        "source_url",
        "observed_at",
        "parser_version",
        "data_mode",
        "completeness"
      ],
      "title": "PlannerSourceProvenanceV1",
      "type": "object"
    },
    "PlannerStatus": {
      "enum": [
        "ready",
        "insufficient_data"
      ],
      "title": "PlannerStatus",
      "type": "string"
    },
    "QuantityReviewEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "keyword": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Keyword",
          "type": "string"
        },
        "keyword_code": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Keyword Code",
          "type": "string"
        },
        "threshold": {
          "default": 50,
          "minimum": 0,
          "title": "Threshold",
          "type": "integer"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "available",
            "below_threshold"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_review_count": {
          "minimum": 0,
          "title": "Source Review Count",
          "type": "integer"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "previous_rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Rank"
        },
        "selected_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Count"
        },
        "participant_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participant Count"
        },
        "response_rate_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Rate Percent"
        },
        "total_vote_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Vote Count"
        },
        "keyword_review_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keyword Review Count"
        }
      },
      "required": [
        "keyword",
        "keyword_code",
        "eligible",
        "status",
        "source_review_count"
      ],
      "title": "QuantityReviewEvidenceV1",
      "type": "object"
    },
    "SemanticFieldStatus": {
      "enum": [
        "explicit",
        "normalized",
        "inferred",
        "ambiguous"
      ],
      "title": "SemanticFieldStatus",
      "type": "string"
    },
    "SemanticProvenanceV1": {
      "additionalProperties": false,
      "properties": {
        "source_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        },
        "source_url": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SemanticFieldStatus"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLabel"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "prompt_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prompt Version"
        },
        "source_content_hash": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Source Content Hash",
          "type": "string"
        },
        "enriched_at": {
          "format": "date-time",
          "title": "Enriched At",
          "type": "string"
        }
      },
      "required": [
        "source_text",
        "source_url",
        "status",
        "confidence",
        "model",
        "prompt_version",
        "source_content_hash",
        "enriched_at"
      ],
      "title": "SemanticProvenanceV1",
      "type": "object"
    },
    "ServingEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
