      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/RestrictionDisclosureStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "RestrictionDisclosureV2",
      "type": "object"
    },
    "RiskPreference": {
      "enum": [
        "minimize_leftovers",
        "balanced",
        "minimize_shortage"
      ],
      "title": "RiskPreference",
      "type": "string"
    },
    "SemanticNamespace": {
      "enum": [
        "allergen",
        "diet",
        "ingredient",
        "food_category",
        "spice",
        "dish",
        "flavor",
        "restaurant_feature",
        "other"
      ],
      "title": "SemanticNamespace",
      "type": "string"
    },
    "SemanticTermV2": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "$ref": "#/$defs/SemanticNamespace"
        },
        "code": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "code",
        "label"
      ],
      "title": "SemanticTermV2",
      "type": "object"
    },
    "ServiceStyle": {
      "enum": [
        "full_meal",
        "light_meal",
        "snack",
        "shared_tasting",
        "other"
      ],
      "title": "ServiceStyle",
      "type": "string"
    },
    "ToleranceLevel": {
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "title": "ToleranceLevel",
      "type": "string"
    },
    "UnresolvedIssueKind": {
      "enum": [
        "missing",
        "ambiguous",
        "conflicting",
        "unsupported"
      ],
      "title": "UnresolvedIssueKind",
      "type": "string"
    },
