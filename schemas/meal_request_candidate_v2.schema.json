{
  "$defs": {
    "ActivityContext": {
      "enum": [
        "ordinary",
        "club_meal",
        "meeting",
        "workshop",
        "party",
        "sports_event",
        "school_event",
        "other"
      ],
      "title": "ActivityContext",
      "type": "string"
    },
    "ActivityLevel": {
      "enum": [
        "none",
        "light",
        "moderate",
        "heavy",
        "unknown"
      ],
      "title": "ActivityLevel",
      "type": "string"
    },
    "AppetiteBand": {
      "enum": [
        "very_light",
        "light",
        "normal",
        "large",
        "very_large",
        "custom"
      ],
      "title": "AppetiteBand",
      "type": "string"
    },
    "AppetiteProfileV2": {
      "additionalProperties": false,
      "properties": {
        "band": {
          "$ref": "#/$defs/AppetiteBand"
        },
        "stated_servings_milli": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stated Servings Milli"
        }
      },
      "required": [
        "band",
        "stated_servings_milli"
      ],
      "title": "AppetiteProfileV2",
      "type": "object"
    },
    "AttendanceStatus": {
      "enum": [
        "confirmed",
        "expected",
        "uncertain",
        "late"
      ],
      "title": "AttendanceStatus",
      "type": "string"
    },
    "BudgetIntentType": {
      "enum": [
        "no_budget",
        "hard_maximum",
        "approximate_target"
      ],
      "title": "BudgetIntentType",
      "type": "string"
    },
    "BudgetIntentV2": {
      "additionalProperties": false,
      "properties": {
        "budget_type": {
          "$ref": "#/$defs/BudgetIntentType"
        },
        "currency": {
          "anyOf": [
            {
              "const": "KRW",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "target_amount_minor": {
          "anyOf": [
            {
              "maximum": 1000000000000000,
              "minimum": -1000000000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Amount Minor"
        },
        "explicit_maximum_amount_minor": {
          "anyOf": [
            {
              "maximum": 1000000000000000,
              "minimum": -1000000000000000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Explicit Maximum Amount Minor"
        },
        "cost_scope": {
          "$ref": "#/$defs/CostScopeCandidateV2"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Text"
        }
      },
      "required": [
        "budget_type",
        "currency",
        "target_amount_minor",
        "explicit_maximum_amount_minor",
        "cost_scope",
        "source_text"
      ],
      "title": "BudgetIntentV2",
      "type": "object"
    },
    "CategorySelection": {
      "enum": [
        "include_all",
        "any_of",
        "prefer_all"
      ],
      "title": "CategorySelection",
      "type": "string"
    },
    "CostScopeCandidateV2": {
      "additionalProperties": false,
      "properties": {
        "include_menu_price": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Include Menu Price"
        },
        "include_delivery_fee": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Include Delivery Fee"
        },
        "include_service_fee": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Include Service Fee"
        },
        "include_discount": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Include Discount"
        }
      },
      "required": [
        "include_menu_price",
        "include_delivery_fee",
        "include_service_fee",
        "include_discount"
      ],
      "title": "CostScopeCandidateV2",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "explicit",
        "inferred",
        "defaulted",
        "conflicted"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceV2": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "field_path": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^/.*",
          "title": "Field Path",
          "type": "string"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Text"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "start_offset": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Offset"
        },
        "end_offset": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Offset"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        }
      },
      "required": [
        "evidence_id",
        "field_path",
        "source_text",
        "status",
        "confidence",
        "start_offset",
        "end_offset",
        "note"
      ],
      "title": "EvidenceV2",
      "type": "object"
    },
    "FoodRole": {
      "enum": [
        "primary_meal",
        "supplementary_meal",
        "snack",
        "tasting",
        "other"
      ],
      "title": "FoodRole",
      "type": "string"
    },
    "FoodScopeV2": {
      "additionalProperties": false,
      "properties": {
        "requested_categories": {
          "items": {
            "$ref": "#/$defs/SemanticTermV2"
          },
          "maxItems": 16,
          "title": "Requested Categories",
          "type": "array"
        },
        "category_selection": {
          "$ref": "#/$defs/CategorySelection"
        },
        "excluded_categories": {
          "items": {
            "$ref": "#/$defs/SemanticTermV2"
          },
          "maxItems": 16,
          "title": "Excluded Categories",
          "type": "array"
        },
        "restaurant_mixing": {
          "$ref": "#/$defs/RestaurantMixing"
        }
      },
      "required": [
        "requested_categories",
        "category_selection",
        "excluded_categories",
        "restaurant_mixing"
      ],
      "title": "FoodScopeV2",
      "type": "object"
    },
    "HardRequirementKind": {
      "enum": [
        "allergy",
        "diet",
        "food_exclusion",
        "religious_rule",
        "spice_limit"
      ],
      "title": "HardRequirementKind",
      "type": "string"
    },
    "HardRequirementV2": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/HardRequirementKind"
        },
        "affected_group_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Affected Group Ids",
          "type": "array"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/SemanticTermV2"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Terms",
          "type": "array"
        },
        "source_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "kind",
        "affected_group_ids",
        "terms",
        "source_text"
      ],
      "title": "HardRequirementV2",
      "type": "object"
    },
    "LeftoverStorage": {
      "enum": [
        "available",
        "unavailable",
        "unknown"
      ],
      "title": "LeftoverStorage",
      "type": "string"
    },
    "LocaleCode": {
      "enum": [
        "ko",
        "en",
        "mixed",
        "unknown"
      ],
      "title": "LocaleCode",
      "type": "string"
    },
    "LocationHintV2": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/LocationSource"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Query"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Longitude"
        }
      },
      "required": [
        "source",
        "query",
        "latitude",
        "longitude"
      ],
      "title": "LocationHintV2",
      "type": "object"
    },
    "LocationSource": {
      "enum": [
        "user_text",
        "browser_geolocation",
        "request_context",
        "application_default"
      ],
      "title": "LocationSource",
      "type": "string"
    },
    "MealType": {
      "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "late_night",
        "snack",
        "other"
      ],
      "title": "MealType",
      "type": "string"
    },
    "OccasionCandidateV2": {
      "additionalProperties": false,
      "properties": {
        "meal_type": {
          "$ref": "#/$defs/MealType"
        },
        "service_style": {
          "$ref": "#/$defs/ServiceStyle"
        },
        "activity_context": {
          "$ref": "#/$defs/ActivityContext"
        },
        "food_role": {
          "$ref": "#/$defs/FoodRole"
        },
        "leftover_storage": {
          "$ref": "#/$defs/LeftoverStorage"
        },
        "scheduled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scheduled At"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10080,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Minutes"
        }
      },
      "required": [
        "meal_type",
        "service_style",
        "activity_context",
        "food_role",
        "leftover_storage",
        "scheduled_at",
        "duration_minutes"
      ],
      "title": "OccasionCandidateV2",
      "type": "object"
    },
    "ParticipantGroupV2": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Group Id",
          "type": "string"
        },
        "display_label": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Label"
        },
        "count": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "Count",
          "type": "integer"
        },
        "attendance_status": {
          "$ref": "#/$defs/AttendanceStatus"
        },
        "appetite": {
          "$ref": "#/$defs/AppetiteProfileV2"
        },
        "activity_level": {
          "$ref": "#/$defs/ActivityLevel"
        },
        "recent_meal_status": {
          "$ref": "#/$defs/RecentMealStatus"
        }
      },
      "required": [
        "group_id",
        "display_label",
        "count",
        "attendance_status",
        "appetite",
        "activity_level",
        "recent_meal_status"
      ],
      "title": "ParticipantGroupV2",
      "type": "object"
    },
    "PartyCandidateV2": {
      "additionalProperties": false,
      "properties": {
        "total_count": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "Total Count",
          "type": "integer"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/ParticipantGroupV2"
          },
          "maxItems": 100,
          "title": "Groups",
          "type": "array"
        }
      },
      "required": [
        "total_count",
        "groups"
      ],
      "title": "PartyCandidateV2",
      "type": "object"
    },
    "PreferencePolarity": {
      "enum": [
        "prefer",
        "avoid"
      ],
      "title": "PreferencePolarity",
      "type": "string"
    },
    "PreferenceStrength": {
      "enum": [
        "weak",
        "normal",
        "strong"
      ],
      "title": "PreferenceStrength",
      "type": "string"
    },
    "PreferenceTargetKind": {
      "enum": [
        "food_category",
        "dish",
        "ingredient",
        "flavor",
        "texture",
        "spice",
        "restaurant",
        "variety",
        "other"
      ],
      "title": "PreferenceTargetKind",
      "type": "string"
    },
    "PreferenceV2": {
      "additionalProperties": false,
      "properties": {
        "preference_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Preference Id",
          "type": "string"
        },
        "target_kind": {
          "$ref": "#/$defs/PreferenceTargetKind"
        },
        "polarity": {
          "$ref": "#/$defs/PreferencePolarity"
        },
        "strength": {
          "$ref": "#/$defs/PreferenceStrength"
        },
        "affected_group_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Affected Group Ids",
          "type": "array"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/SemanticTermV2"
          },
          "maxItems": 32,
          "title": "Terms",
          "type": "array"
        },
        "source_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        }
      },
      "required": [
        "preference_id",
        "target_kind",
        "polarity",
        "strength",
        "affected_group_ids",
        "terms",
        "source_text"
      ],
      "title": "PreferenceV2",
      "type": "object"
    },
    "QuantityPreferenceCandidateV2": {
      "additionalProperties": false,
      "properties": {
        "primary_objective": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskPreference"
            },
            {
              "type": "null"
            }
          ]
        },
        "shortage_tolerance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToleranceLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "leftover_tolerance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToleranceLevel"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "primary_objective",
        "shortage_tolerance",
        "leftover_tolerance"
      ],
      "title": "QuantityPreferenceCandidateV2",
      "type": "object"
    },
    "RecentMealStatus": {
      "enum": [
        "not_recent",
        "light_meal_recently",
        "full_meal_recently",
        "unknown"
      ],
      "title": "RecentMealStatus",
      "type": "string"
    },
    "RestaurantMixing": {
      "enum": [
        "single_restaurant_required",
        "single_restaurant_preferred",
        "multiple_allowed",
        "unspecified"
      ],
      "title": "RestaurantMixing",
      "type": "string"
    },
    "RestaurantPreferencesV2": {
      "additionalProperties": false,
      "properties": {
        "preferred_names": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Preferred Names",
          "type": "array"
        },
        "excluded_names": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Excluded Names",
          "type": "array"
        }
      },
      "required": [
        "preferred_names",
        "excluded_names"
      ],
      "title": "RestaurantPreferencesV2",
      "type": "object"
    },
    "RestrictionDisclosureStatus": {
      "enum": [
        "reported",
        "none_reported",
        "not_provided"
      ],
      "title": "RestrictionDisclosureStatus",
      "type": "string"
    },
