      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Issue Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/UnresolvedIssueKind"
        },
        "field_path": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^/.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field Path"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Text"
        }
      },
      "required": [
        "issue_id",
        "kind",
        "field_path",
        "message",
        "source_text"
      ],
      "title": "UnresolvedIssueV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The only model-owned structured output.",
  "properties": {
    "locale": {
      "$ref": "#/$defs/LocaleCode"
    },
    "occasion": {
      "$ref": "#/$defs/OccasionCandidateV2"
    },
    "party": {
      "$ref": "#/$defs/PartyCandidateV2"
    },
    "location_hint": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocationHintV2"
        },
        {
          "type": "null"
        }
      ]
    },
    "food_scope": {
      "$ref": "#/$defs/FoodScopeV2"
    },
    "hard_requirements": {
      "items": {
        "$ref": "#/$defs/HardRequirementV2"
      },
      "maxItems": 100,
      "title": "Hard Requirements",
      "type": "array"
    },
    "preferences": {
      "items": {
        "$ref": "#/$defs/PreferenceV2"
      },
      "maxItems": 100,
      "title": "Preferences",
      "type": "array"
    },
    "budget_intent": {
