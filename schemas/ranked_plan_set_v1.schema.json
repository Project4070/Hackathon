{
  "$defs": {
    "CombinationLineV1": {
      "additionalProperties": false,
      "properties": {
        "menu_item_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Menu Item Id",
          "type": "string"
        },
        "quantity": {
          "maximum": 100,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "unit_servings_milli": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Unit Servings Milli",
          "type": "integer"
        },
        "line_servings_milli": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Line Servings Milli",
          "type": "integer"
        },
        "unit_price_minor": {
          "maximum": 10000000000,
          "minimum": 0,
          "title": "Unit Price Minor",
          "type": "integer"
        },
        "line_price_minor": {
          "maximum": 10000000000,
          "minimum": 0,
          "title": "Line Price Minor",
          "type": "integer"
        }
      },
      "required": [
        "menu_item_id",
        "quantity",
        "unit_servings_milli",
        "line_servings_milli",
        "unit_price_minor",
        "line_price_minor"
      ],
      "title": "CombinationLineV1",
      "type": "object"
    },
    "MetricScoreV1": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Metric",
          "type": "string"
        },
        "score_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Score Basis Points",
          "type": "integer"
        },
        "weighted_score": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Weighted Score",
          "type": "integer"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "score_basis_points",
        "weighted_score",
        "reason"
      ],
      "title": "MetricScoreV1",
      "type": "object"
    },
    "OrderCombinationV1": {
      "additionalProperties": false,
      "properties": {
        "combination_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Combination Id",
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/PlanStrategy"
        },
        "restaurant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Restaurant Id",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/CombinationLineV1"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "target_servings_milli": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Target Servings Milli",
          "type": "integer"
        },
        "total_servings_milli": {
          "maximum": 10000000,
          "minimum": 0,
          "title": "Total Servings Milli",
          "type": "integer"
        },
        "surplus_servings_milli": {
          "maximum": 10000000,
          "minimum": -10000000,
          "title": "Surplus Servings Milli",
          "type": "integer"
        },
        "item_subtotal_minor": {
          "maximum": 10000000000,
          "minimum": 0,
          "title": "Item Subtotal Minor",
          "type": "integer"
        },
        "fees_minor": {
          "maximum": 10000000000,
          "minimum": 0,
          "title": "Fees Minor",
          "type": "integer"
        },
        "total_cost_minor": {
          "maximum": 10000000000,
          "minimum": 0,
          "title": "Total Cost Minor",
          "type": "integer"
        },
        "budget_evaluated_cost_minor": {
          "maximum": 10000000000,
          "minimum": 0,
          "title": "Budget Evaluated Cost Minor",
          "type": "integer"
        },
        "validation": {
          "$ref": "#/$defs/PlanValidationV1"
        }
      },
      "required": [
        "combination_id",
        "strategy",
        "restaurant_id",
        "lines",
        "target_servings_milli",
        "total_servings_milli",
        "surplus_servings_milli",
        "item_subtotal_minor",
        "fees_minor",
        "total_cost_minor",
        "budget_evaluated_cost_minor",
        "validation"
      ],
      "title": "OrderCombinationV1",
      "type": "object"
    },
    "PlanStrategy": {
      "enum": [
        "leftover_minimizing",
        "balanced",
        "shortage_minimizing"
      ],
      "title": "PlanStrategy",
      "type": "string"
    },
    "PlanValidationV1": {
      "additionalProperties": false,
      "properties": {
        "hard_constraints_passed": {
          "title": "Hard Constraints Passed",
          "type": "boolean"
        },
        "group_coverage_passed": {
          "title": "Group Coverage Passed",
          "type": "boolean"
        },
        "quantity_passed": {
          "title": "Quantity Passed",
          "type": "boolean"
        },
        "budget_passed": {
          "title": "Budget Passed",
          "type": "boolean"
        },
        "delivery_passed": {
          "title": "Delivery Passed",
          "type": "boolean"
        },
        "minimum_order_passed": {
          "title": "Minimum Order Passed",
          "type": "boolean"
        },
        "category_coverage_passed": {
          "title": "Category Coverage Passed",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "hard_constraints_passed",
        "group_coverage_passed",
        "quantity_passed",
        "budget_passed",
        "delivery_passed",
        "minimum_order_passed",
        "category_coverage_passed",
        "issues"
      ],
      "title": "PlanValidationV1",
      "type": "object"
    },
    "ScoredCombinationV1": {
      "additionalProperties": false,
      "properties": {
        "combination": {
          "$ref": "#/$defs/OrderCombinationV1"
        },
        "total_score": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Total Score",
          "type": "integer"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricScoreV1"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "soft_preference_reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Soft Preference Reasons",
          "type": "array"
        }
      },
      "required": [
        "combination",
        "total_score",
        "metrics",
        "soft_preference_reasons"
      ],
      "title": "ScoredCombinationV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "const": "ranked_plan_set",
      "default": "ranked_plan_set",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Case Id",
      "type": "string"
    },
    "profile_revision": {
      "minimum": 1,
      "title": "Profile Revision",
      "type": "integer"
    },
    "scored_combination_set_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Scored Combination Set Id",
      "type": "string"
    },
    "plans": {
      "items": {
        "$ref": "#/$defs/ScoredCombinationV1"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Plans",
      "type": "array"
    },
    "recommended_strategy": {
      "$ref": "#/$defs/PlanStrategy"
    },
    "recommendation_reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Recommendation Reason",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "profile_revision",
    "scored_combination_set_id",
    "plans",
    "recommended_strategy",
    "recommendation_reason"
  ],
  "title": "RankedPlanSetV1",
  "type": "object"
}
